# ==============================================================================
# ACTIS (Automated Cyber Threat Intelligence System) — Environment Configuration
# ==============================================================================
# Copy this file to .env at project root:
#   copy .env.example .env
#
# IMPORTANT SECURITY NOTE:
# Never commit real API keys, tokens, or credentials to version control.
# The .env file is strictly ignored by Git. Keep all production credentials safe.
# ==============================================================================

# Application Environment (development, testing, staging, production)
ACTIS_ENVIRONMENT=development

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
ACTIS_LOG_LEVEL=INFO

# Central ACTIS Backend Configuration (Threat Intelligence Sync)
ACTIS_BACKEND_URL=http://127.0.0.1:8000
ACTIS_CLIENT_API_KEY=your_client_secret_token_here
ACTIS_SERVER_HOST=127.0.0.1
ACTIS_SERVER_PORT=8000

# Database Operational Settings
ACTIS_DB_TIMEOUT=30.0
ACTIS_DB_WAL=true

# External Threat Intelligence Provider Configuration (Leave blank if offline/unused)
VIRUSTOTAL_ENABLED=true
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
URLHAUS_ENABLED=true
URLHAUS_API_KEY=your_urlhaus_api_key_here
ABUSEIPDB_ENABLED=true
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
OPENPHISH_API_KEY=your_openphish_api_key_here
PHISHTANK_API_KEY=your_phishtank_api_key_here

# Network Request Timeouts & Threat Intelligence Caching
ACTIS_REQUEST_TIMEOUT=5.0
ACTIS_TI_CACHE_TTL=3600
ACTIS_TI_MAX_RETRIES=1
ACTIS_VT_RATE_LIMIT_RPM=4

# Scanner Operational Settings
ACTIS_MAX_FILE_SIZE_MB=100
ACTIS_HASH_CHUNK_SIZE=65536
ACTIS_WATCHDOG_DEBOUNCE_SECONDS=2.0
