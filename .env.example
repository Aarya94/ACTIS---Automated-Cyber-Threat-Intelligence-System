# ACTIS Environment Configuration
# Copy this file to .env and configure your keys

# External Threat Intelligence API Keys (optional - system works offline if not set)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
URLHAUS_API_KEY=

# Central ACTIS Threat Intelligence Backend
ACTIS_BACKEND_URL=http://127.0.0.1:8000
ACTIS_CLIENT_API_KEY=actis-client-default-secret-token
