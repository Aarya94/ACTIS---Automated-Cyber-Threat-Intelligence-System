# ACTIS environment variables example
# Copy to .env and fill values for local testing

# External APIs
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
URLHAUS_API_KEY=

# Central backend
ACTIS_BACKEND_URL=http://127.0.0.1:8000
ACTIS_CLIENT_API_KEY=actis-client-default-secret-token

# Logging
ACTIS_LOG_LEVEL=INFO
